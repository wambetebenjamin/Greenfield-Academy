#######################################################################
# Greenfield Academy, environment variables
# Copy to .env.local for development, add the same keys in Vercel for
# production. Every integration degrades gracefully when a key is absent.
#######################################################################

# Public site URL, used for canonical tags, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://greenfieldacademy.co.ke

# ----------------------------------------------------------------------
# Vercel KV (Upstash Redis). Added automatically when you connect a KV
# store to the project from the Vercel dashboard.
# Without these the app writes to a local .data folder instead.
# ----------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# ----------------------------------------------------------------------
# NextAuth, staff portal authentication
# Generate a secret with: openssl rand -base64 32
# ----------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://greenfieldacademy.co.ke

# JSON array of staff accounts. Falls back to demo accounts when unset.
# STAFF_USERS=[{"email":"principal@greenfieldacademy.co.ke","password":"change-me","name":"Dr. Margaret Wanjiku","role":"admin"}]
STAFF_USERS=

# ----------------------------------------------------------------------
# Email, Nodemailer SMTP (Gmail, Zoho, Mailgun, Resend SMTP, etc.)
# ----------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Greenfield Academy <info@greenfieldacademy.co.ke>"

# Where internal notifications land
ADMISSIONS_EMAIL=admissions@greenfieldacademy.co.ke
CONTACT_EMAIL=info@greenfieldacademy.co.ke

# ----------------------------------------------------------------------
# WhatsApp Cloud API, notifications to the admissions desk
# ----------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
